.env
.env.*
!.env.example
!.env.template
*.secret

# Logs and test output
*.log
/frontend/coverage/
/frontend/playwright-report/
/frontend/test-results/

# Local database exports
*.dump
*.backup
*.sql.gz

# Local assistant settings
.claude/
